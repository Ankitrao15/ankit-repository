# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# SECURITY NOTICE: Never commit real secrets, API keys, or connection strings.
# Copy this file to .env and populate values via secure deployment secrets.
# ============================================================================

# GEMINI_API_KEY: Server-side only API key for @google/genai (gemini-4-argon).
# NEVER expose with VITE_, NEXT_PUBLIC_, or REACT_APP_ prefixes.
GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY_HERE"

i# APP_URL: Canonical origin URL used for strict CORS allowlisting in production.
APP_URL="http://localhost:3000"

# GITHUB_USERNAME: Public GitHub handle for real-time repository synchronization.
GITHUB_USERNAME="Ankitrao15"

# GITHUB_TOKEN: Optional server-side GitHub PAT to increase rate limits (server-only).
GITHUB_TOKEN=""

# SESSION_SIGNING_SECRET: Server-side HMAC secret for signing deletion tokens.
SESSION_SIGNING_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"
